# See https://help.github.com/articles/ignoring-files/ for more details about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# 1. Create .gitignore
echo "node_modules/
.next/
.env
.env.local
.env*.local
*.log
.DS_Store
test-api.mjs" > .gitignore


# Remove node_modules from git tracking (keeps files on disk)
git rm -r --cached node_modules

# Also remove .next if it got tracked
git rm -r --cached .next 2>$null

# Commit the removal
git commit -m "chore: remove node_modules and .next from tracking"

# Now push — will be fast, only source files
git push -u origin main